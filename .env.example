# Copy to .env.local for local development; replace both public placeholders.
# On GitHub Pages, add these as repository Actions variables instead.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_YOUR_PUBLIC_KEY
# Never put a service_role key, sb_secret_* key, database password or JWT secret here.
